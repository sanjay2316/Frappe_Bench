2026-08-18 11:05:13,987 INFO ipython === bench console session ===
2026-08-18 11:05:13,987 INFO ipython import json
import os

doctypes = [
    "Department",
    "Course",
    "Subject",
    "Teacher",
    "Student",
    "Course Assignment",
    "Enrollment",
    "Attendance",
    "Examination",
    "Marks",
    "Marks Detail"
]

export_dir = "/tmp/student_management_export"
os.makedirs(export_dir, exist_ok=True)

for doctype in doctypes:
    doc = frappe.get_doc("DocType", doctype)
    
    data = doc.as_dict()
    data["module"] = "Student Management"

    filename = doctype.lower().replace(" ", "_") + ".json"
    filepath = os.path.join(export_dir, filename)

    with open(filepath, "w") as f:
        json.dump(data, f, indent=2, default=str)

    print(f"Exported: {doctype} -> {filepath}")

print("All 11 DocTypes exported successfully!")
2026-08-18 11:05:13,987 INFO ipython === session end ===
